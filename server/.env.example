NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pioneer_legacy_works
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# One-time first administrator bootstrap.
# It defaults to enabled outside production and disabled in production.
ENABLE_ADMIN_BOOTSTRAP=true

# Required whenever administrator bootstrap is enabled in production.
# Optional in local development.
# ADMIN_BOOTSTRAP_SECRET=replace-with-a-temporary-secret-at-least-16-characters
